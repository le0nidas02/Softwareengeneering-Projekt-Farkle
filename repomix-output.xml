<file path="src/main/scala/de/htwg/se/farkle/util/UndoManager.scala">
package de.htwg.se.farkle.util

trait Command {
  def doStep(): Unit
  def undoStep(): Unit
  def redoStep(): Unit
}

class UndoManager {
  private var undoStack: List[Command] = Nil
  private var redoStack: List[Command] = Nil

  def doStep(command: Command): Unit = {
    undoStack = command :: undoStack
    redoStack = Nil
    command.doStep()
  }

  def undoStep(): Unit = {
    undoStack match {
      case Nil => // Nichts rückgängig zu machen
      case head :: stack =>
        head.undoStep()
        undoStack = stack
        redoStack = head :: redoStack
    }
  }

  def redoStep(): Unit = {
    redoStack match {
      case Nil => // Nichts zu wiederholen
      case head :: stack =>
        head.redoStep()
        redoStack = stack
        undoStack = head :: undoStack
    }
  }
}
</file>

